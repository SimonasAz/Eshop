generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id])
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER) 
  reviews  Review[]
}

model TrendingGame {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  price     Float
  discount  Float?
  imageUrl  String
  createdAt DateTime @default(now())
}

model Game {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float
  discount    Float?
  category    String
  imageUrl    String
  createdAt   DateTime @default(now())
  
  reviews Review[]
}

enum Role {
  ADMIN
  USER
}
